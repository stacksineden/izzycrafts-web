# coming_soon (default) shows the Coming Soon page. live switches on the full store.
VITE_SITE_MODE=coming_soon
# Production origin, no trailing slash, e.g. https://www.example.com
# Needed for canonical URLs, absolute share images and sitemap.xml.
VITE_SITE_URL=
# Optional. Shows Instagram links when set.
VITE_INSTAGRAM_URL=
